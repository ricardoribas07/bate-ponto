# Deixe estas duas linhas comentadas/ausentes para usar um banco local (arquivo .db).
# Preencha as duas para usar um banco Turso na nuvem (grátis e persistente).
# TURSO_DATABASE_URL=libsql://seu-banco-aqui.turso.io
# TURSO_AUTH_TOKEN=seu-token-aqui

# Texto secreto usado para assinar os tokens de login. Troque por qualquer texto seu.
JWT_SECRET=troque-por-um-texto-secreto-seu

# Porta em que o backend roda localmente (o Render define isso automaticamente em produção)
PORT=3001
